<Window x:Class="PdfTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfTools.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PDF Tools"
        Width="1200" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFilesCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header / command bar -->
            <RowDefinition Height="*" />     <!-- files + pages -->
            <RowDefinition Height="Auto" />  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== Header & command bar ===================== -->
        <DockPanel Grid.Row="0" Margin="20,16,20,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="20"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PDF Tools" Style="{DynamicResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Merge files, reorder pages, save a new PDF"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddFilesCommand}" ToolTip="Add PDF files (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                        <TextBlock Text="Add PDFs" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <Button x:Name="SortButton" Style="{StaticResource ToolbarButton}" Click="SortButton_Click"
                        IsEnabled="{Binding HasPages}" ToolTip="Re-order all pages">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8CB;" />
                        <TextBlock Text="Sort" Margin="8,0,6,0" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="22" Margin="10,0,6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveUpCommand}" ToolTip="Move selected pages earlier (Ctrl+↑)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding MoveDownCommand}" ToolTip="Move selected pages later (Ctrl+↓)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RemoveCommand}" ToolTip="Remove selected pages (Delete)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}" ToolTip="Remove all pages">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" />
                </Button>

                <Rectangle Width="1" Height="22" Margin="10,0,6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Button Style="{StaticResource AccentToolbarButton}" Command="{Binding SaveCommand}" ToolTip="Save as a new PDF (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                        <TextBlock Text="Save PDF" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ===================== Files panel + page grid ===================== -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Files -->
            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1" Padding="4,12,4,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Files" Margin="12,0,0,8" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock DockPanel.Dock="Top" Margin="12,0" TextWrapping="Wrap"
                               Text="No files yet."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="4" Padding="8,6" Margin="0,1" Background="Transparent" ToolTip="{Binding FilePath}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE8A5;"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                            <Button x:Name="RemoveFile" DockPanel.Dock="Right" Padding="6" Opacity="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip="Remove this file's pages"
                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="11" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding PageCount, Mode=OneWay}" /> pages
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="RemoveFile" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <ListBox x:Name="PageList"
                             ItemsSource="{Binding Pages}"
                             SelectionMode="Extended"
                             Background="Transparent" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             SelectionChanged="PageList_SelectionChanged"
                             PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="PageList_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="PageList_PreviewMouseMove"
                             PreviewKeyDown="PageList_PreviewKeyDown"
                             DragOver="PageList_DragOver"
                             DragLeave="PageList_DragLeave"
                             Drop="PageList_Drop"
                             PreviewMouseWheel="PageList_PreviewMouseWheel"
                             SizeChanged="PageList_SizeChanged"
                             ScrollViewer.ScrollChanged="PageList_ScrollChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Margin" Value="6" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- Card look: replace this template to change how a page card looks. -->
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Card" CornerRadius="8" BorderThickness="2" Padding="8"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <!-- Drop markers shown while dragging -->
                                                <Border x:Name="MarkerBefore" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="-7,4,0,4"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <Border x:Name="MarkerAfter" Width="4" CornerRadius="2" HorizontalAlignment="Right" Margin="0,4,-7,4"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding DropPosition}" Value="Before">
                                                    <Setter TargetName="MarkerBefore" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DropPosition}" Value="After">
                                                    <Setter TargetName="MarkerAfter" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                <StackPanel Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            ToolTip="{Binding FilePath}">
                                    <Grid Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <!-- Page preview (white paper with shadow) -->
                                        <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18" />
                                            </Border.Effect>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Loading / error placeholder -->
                                        <TextBlock x:Name="Placeholder" Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />

                                        <!-- Position badge -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0"
                                                CornerRadius="10" MinWidth="24" Height="20" Padding="7,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Position}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding FileName}" Margin="2,8,2,0" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PageLabel}" Margin="2,0" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ThumbnailFailed}" Value="True">
                                        <Setter TargetName="Placeholder" Property="Text" Value="No preview" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPages}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE898;" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Drop PDF files here" Margin="0,16,0,4" HorizontalAlignment="Center"
                                   Style="{DynamicResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Pages appear as cards — drag them to change the order."
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource AccentToolbarButton}" Margin="0,20,0,0" HorizontalAlignment="Center"
                                Command="{Binding AddFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                                <TextBlock Text="Browse for PDFs" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <DockPanel Grid.Row="2" Margin="24,10,24,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ZoomButton}" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out" ToolTip="Zoom out (Ctrl+−, Ctrl+scroll)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE71F;" FontSize="14" />
                </Button>
                <Slider Width="180" Margin="6,0" VerticalAlignment="Center"
                        Minimum="{x:Static vm:MainViewModel.MinThumbnailWidth}"
                        Maximum="{Binding MaxZoomWidth}"
                        Value="{Binding ThumbnailWidth}" ToolTip="Thumbnail size" />
                <Button Style="{StaticResource ZoomButton}" Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in" ToolTip="Zoom in (Ctrl+=, Ctrl+scroll)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A3;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ZoomButton}" Command="{Binding ResetZoomCommand}" AutomationProperties.Name="Reset zoom" MinWidth="52" Margin="4,0,0,0"
                        ToolTip="Reset zoom (Ctrl+0)">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding ZoomPercent, Mode=OneWay}" />%
                    </TextBlock>
                </Button>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Right" Width="120" Margin="0,0,20,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
